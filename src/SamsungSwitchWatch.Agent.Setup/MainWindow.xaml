<Window x:Class="SamsungSwitchWatch.Agent.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Samsung Switch Watch Agent Setup"
        Width="760"
        Height="700"
        MinWidth="680"
        MinHeight="660"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Agent 설치 및 점검"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ModeDescription"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Agent는 설치 후 창 없이 Windows 서비스로 실행됩니다." />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="설치 내용"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,10,0,0"
                           Text="● 창 없이 실행되는 Windows Agent 서비스" />
                <TextBlock Margin="0,6,0,0"
                           Text="● 사설 Viewer 대역용 HTTPS/TCP 18443 연결 규칙" />
                <TextBlock Margin="0,6,0,0"
                           Text="● RFC1918 사설 관리망 스위치의 Telnet/TCP 23 조회" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="Viewer IP와 관리망 CIDR은 따로 입력하지 않습니다. 10/8, 172.16/12, 192.168/16 사설 대역을 자동 적용합니다." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="12,10"
                CornerRadius="6"
                Background="#FFFBEB"
                BorderBrush="#F59E0B"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="설치와 연결 확인은 별도 단계입니다"
                           FontWeight="SemiBold"
                           Foreground="#92400E" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#92400E"
                           TextWrapping="Wrap"
                           Text="Agent 서비스 설치가 끝나면 로컬 HTTPS 또는 방화벽 확인이 늦어져도 설치를 되돌리지 않습니다. 경고가 표시되면 Viewer에서 연결 테스트를 실행하세요." />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="점검 및 설치 결과"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               x:Name="OperationStateText"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="대기" />
                </Grid>
                <Border Grid.Row="1"
                        x:Name="RecoveryStatusBorder"
                        Margin="0,0,0,8"
                        Padding="10"
                        CornerRadius="4"
                        Background="#FFFBEB"
                        BorderBrush="#F59E0B"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="RecoveryStatusTitle"
                                   FontWeight="SemiBold"
                                   Text="이전 상태 복구 필요" />
                        <TextBlock x:Name="RecoveryStatusText"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Symbol}"
                                               Foreground="{Binding Brush}"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Message}" />
                                        <TextBlock Text="{Binding Code}"
                                                   Margin="0,2,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="3"
                        x:Name="SupportCodeBorder"
                        Margin="0,10,0,0"
                        Padding="10,8"
                        CornerRadius="6"
                        Background="#FFFBEB"
                        BorderBrush="#D97706"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        AutomationProperties.Name="지원 코드">
                    <StackPanel>
                        <TextBlock Text="지원 코드 · 이 코드만 전달하세요"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#B45309" />
                        <TextBox x:Name="SupportCodeTextBox"
                                 Margin="0,2,0,0"
                                 Padding="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="True"
                                 Text=""
                                 AutomationProperties.Name="지원 코드 값" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       x:Name="ActionGuidanceText"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="설정 변경은 설치 버튼을 누른 뒤에만 수행됩니다." />
            <TextBlock Grid.Row="1"
                       x:Name="DiagnosticsCopyFeedbackText"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Visibility="Collapsed" />
            <StackPanel Grid.Row="2"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="SaveFieldDiagnosticButton"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="SaveFieldDiagnosticButton_Click"
                        Content="익명 진단 저장"
                        Visibility="Collapsed" />
                <Button x:Name="CopyDiagnosticsButton"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="CopyDiagnosticsButton_Click"
                        Content="진단정보 복사"
                        Visibility="Collapsed" />
                <Button x:Name="CheckButton"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="CheckButton_Click"
                        Content="사전 점검"
                        Visibility="Collapsed" />
                <Button x:Name="RecoverButton"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Click="RecoverButton_Click"
                        Content="이전 상태 복구"
                        Visibility="Collapsed" />
                <Button x:Name="InstallButton"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Click="InstallButton_Click"
                        Content="설치 / 업데이트" />
                <Button Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click"
                        Content="취소" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
