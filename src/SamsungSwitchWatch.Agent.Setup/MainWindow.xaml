<Window x:Class="SamsungSwitchWatch.Agent.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Samsung Switch Watch Agent Setup"
        Width="760"
        Height="700"
        MinWidth="680"
        MinHeight="660"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Agent 설치 및 점검"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ModeDescription"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Agent는 설치 후 창 없이 Windows 서비스로 실행됩니다." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="1. Viewer PC 고정 IPv4"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,10"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="이 주소의 Viewer만 Agent 원격 업무 API를 사용할 수 있습니다." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ViewerIpTextBox"
                             Height="36"
                             Padding="10,6"
                             VerticalContentAlignment="Center"
                             ToolTip="예: 10.20.30.41" />
                    <Button Grid.Column="1"
                            x:Name="UseThisPcAddressButton"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Padding="12,6"
                            MinHeight="36"
                            Click="UseThisPcAddressButton_Click"
                            Content="이 PC 주소 넣기"
                            ToolTip="Agent와 Viewer를 이 PC에 함께 설치해 사전 테스트할 때 사용합니다." />
                </Grid>
                <ComboBox x:Name="ViewerAddressCandidatesComboBox"
                          Margin="0,8,0,0"
                          Height="34"
                          Padding="8,4"
                          DisplayMemberPath="DisplayText"
                          SelectionChanged="ViewerAddressCandidatesComboBox_SelectionChanged"
                          Visibility="Collapsed"
                          ToolTip="이 PC에서 사용할 사설 IPv4 주소를 선택하세요." />
                <TextBlock x:Name="ViewerAddressFeedbackText"
                           Margin="4,6,4,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           Visibility="Collapsed"
                           TextWrapping="Wrap" />
                <TextBlock Margin="4,5,4,0"
                           FontSize="11"
                           Foreground="#B45309"
                           TextWrapping="Wrap"
                           Text="동일 PC 사전 테스트용입니다. 원격 배치 전 실제 Viewer PC의 고정 IPv4로 바꾸세요." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="2. 스위치 관리망 선택"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            x:Name="RefreshNetworksButton"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,5"
                            MinHeight="30"
                            Click="RefreshNetworksButton_Click"
                            Content="다시 검색" />
                </Grid>
                <TextBlock Margin="0,4,0,10"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="자동 검색 결과를 선택하거나 승인된 사설 IPv4 CIDR을 직접 추가하세요. 합계 최대 2개입니다." />
                <ScrollViewer MaxHeight="96"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NetworkItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="4,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="NetworkSelectionChanged"
                                                  Unchecked="NetworkSelectionChanged">
                                            <TextBlock Text="{Binding DisplayText, Mode=OneWay}" />
                                        </CheckBox>
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Padding="10,5"
                                                VerticalAlignment="Center"
                                                Click="RemoveManualNetworkButton_Click"
                                                Content="삭제">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRemove}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="NoNetworksText"
                           Margin="4,8,4,0"
                           Foreground="#B45309"
                           Visibility="Collapsed"
                           Text="자동 검색된 관리망이 없습니다. 아래에서 승인된 관리망을 직접 추가하세요." />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="관리망 직접 추가" />
                    <TextBox Grid.Column="1"
                             x:Name="ManualCidrTextBox"
                             Height="34"
                             Padding="10,6"
                             VerticalContentAlignment="Center"
                             KeyDown="ManualCidrTextBox_KeyDown"
                             ToolTip="예: 10.50.0.10/24" />
                    <Button Grid.Column="2"
                            x:Name="AddManualNetworkButton"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Padding="14,6"
                            MinWidth="72"
                            Click="AddManualNetworkButton_Click"
                            Content="추가" />
                </Grid>
                <TextBlock x:Name="ManualNetworkFeedbackText"
                           Margin="4,5,4,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="입력한 주소는 네트워크 주소로 자동 정규화됩니다. 예: 10.50.0.10/24 → 10.50.0.0/24" />
                <TextBlock x:Name="ExistingNetworksWarningText"
                           Margin="4,5,4,0"
                           FontSize="11"
                           Foreground="#B45309"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="점검 및 설치 결과"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               x:Name="OperationStateText"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="대기" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Symbol}"
                                               Foreground="{Binding Brush}"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Message}" />
                                        <TextBlock Text="{Binding Code}"
                                                   Margin="0,2,0,0"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0"
                    Click="CloseButton_Click"
                    Content="닫기" />
            <Button DockPanel.Dock="Right"
                    x:Name="InstallButton"
                    Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0"
                    Click="InstallButton_Click"
                    Content="설치 / 업데이트" />
            <Button DockPanel.Dock="Right"
                    x:Name="CheckButton"
                    Style="{StaticResource SecondaryButton}"
                    Click="CheckButton_Click"
                    Content="사전 점검" />
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="설정 변경은 설치 버튼을 누른 뒤에만 수행됩니다." />
        </DockPanel>
    </Grid>
</Window>
